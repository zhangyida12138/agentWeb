# ══════════════════════════════════════════════════════════════════════════
# 测试环境变量（`uv run pytest` / `make test` 自动加载，不要手动 source）
#
# 怎么被加载的：见 src/app/core/config.py 顶部。
#   APP__ENV=test  → 依次读 [.env, .env.test]，靠后的覆盖靠前的。
#   所以这里只写「测试必须和开发不一样」的项；其余沿用 .env 或字段默认值。
#   但本文件也必须能**单独**工作（CI 里根本没有 .env），因此关键项都写全。
#
# 为什么单独一个文件而不是写在 tests/conftest.py 里：
#   env 文件是配置的唯一出处，改配置不用碰代码；而且 `alembic upgrade head`
#   这类**在测试之外**、也要打测试库的命令，可以直接 `APP__ENV=test` 复用同一份配置。
#
# ⚠️ 本文件不含机密：连的是本机 docker 里的测试库，凭据与 .env.example 一致，
#    所以它**可以提交进仓库**（被 .gitignore 忽略的是 .env）。
# ══════════════════════════════════════════════════════════════════════════

# ──────────────────────────── 应用 ────────────────────────────
APP__NAME=AgentWeb API (test)
APP__ENV=test
APP__DEBUG=false # 测试关 debug，避免每条 SQL / 异常栈刷屏
APP__DOCS_ENABLED=false # 测试不会访问 /docs
APP__PORT=8000
# 必须为空：只要这里配了邮箱，「新用户默认是 reader」这类断言就会莫名其妙地挂掉，
# 而且报错完全指不到这个变量。测试不引导管理员，需要 admin 就显式改角色。
APP__BOOTSTRAP_ADMIN_EMAIL=

# ──────────────────────────── 数据库 ────────────────────────────
# ⚠️ 端口 5433 / 库名 agent_web_test = docker-compose.yml 里的 postgres-test 容器。
#    那是**独立的 Postgres 实例 + 独立数据卷**，与开发库（5432 / agent_web）互不可见，
#    测试怎么建表、怎么删数据都影响不到开发数据。
#    启动它：make db-test-up
DB__URL=postgresql+asyncpg://postgres:postgres@localhost:5433/agent_web_test
DB__ECHO=false # 想看每条 SQL 就临时改 true
DB__POOL_SIZE=5 # 测试并发低，池子调小省资源（用例其实走 NullPool，见 conftest）
DB__MAX_OVERFLOW=10
DB__POOL_PRE_PING=true

# ──────────────────────────── 安全 ────────────────────────────
# 固定密钥（非机密）：让 token 在同一会话的多次调用间稳定可比。
# 缺省时 config.py 会自动生成一次性密钥也能跑，但写死更利于排查。
SECURITY__JWT_SECRET_KEY=test-secret-key-please-change-this-in-production-xxxxxxxxxx
SECURITY__JWT_ALGORITHM=HS256
SECURITY__JWT_EXPIRE_MINUTES=60
# bcrypt 12 轮单次约 250ms，注册 + 改密要各算两次；4 轮（配置下限）让测试回到毫秒级
SECURITY__BCRYPT_ROUNDS=4

# ──────────────────────────── CORS ────────────────────────────
CORS__ALLOW_ORIGINS=[] # 测试只打 API，不经过浏览器，跨域白名单留空

# ──────────────────────────── LLM（P6 再填） ────────────────────────────
LLM__BASE_URL=
LLM__API_KEY=
LLM__MODEL=
