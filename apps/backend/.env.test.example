# 测试环境变量模板。
#
# 使用方式：复制为 .env.test（`Copy-Item .env.test.example .env.test`）。
#
# 加载规则见 src/app/core/config.py：APP__ENV=test 时依次读 [.env, .env.test]，
# 靠后的覆盖靠前的；pytest 会在 import app.* 之前把 APP__ENV 钉死成 test，
# 所以 `uv run pytest` 不需要你做任何额外配置。
#
# 与 .env.example 的关键差异：
#   * DB__URL 指向 **独立的测试容器**（5433 / agent_web_test，见 docker-compose.yml），
#     测试不会碰开发库；
#   * APP__BOOTSTRAP_ADMIN_EMAIL 必须为空，否则「新用户默认是 reader」的断言会挂；
#   * bcrypt 轮数调到下限 4，让注册/改密类用例回到毫秒级。

# 应用
APP__NAME=AgentWeb API (test)
APP__ENV=test
APP__DEBUG=false                      # 测试关 debug，减少日志噪音
APP__DOCS_ENABLED=false               # 测试一般不访问 docs
APP__PORT=8000
APP__BOOTSTRAP_ADMIN_EMAIL=

# 允许跨域的前端地址（测试一般只测 API，关也可以，留空列表）
CORS__ALLOW_ORIGINS=[]

# PostgreSQL —— 独立测试容器，与开发库物理隔离
DB__URL=postgresql+asyncpg://postgres:postgres@localhost:5433/agent_web_test
DB__ECHO=false                        # 测试别打印每条 SQL，排错时临时改 true
DB__POOL_SIZE=5                       # 测试连接池调小，省资源
DB__MAX_OVERFLOW=10
DB__POOL_PRE_PING=true

# 安全（JWT 测试用固定密钥，别和生产共用）
SECURITY__JWT_SECRET_KEY=test-secret-key-please-change-this-in-production-xxxxxxxxxx
SECURITY__JWT_ALGORITHM=HS256
SECURITY__JWT_EXPIRE_MINUTES=60
SECURITY__BCRYPT_ROUNDS=4             # 4 轮（配置下限）加速用例；生产必须 12+

# LLM（测试一般打桩，留空让测试替身代替）
LLM__BASE_URL=
LLM__API_KEY=
LLM__MODEL=
