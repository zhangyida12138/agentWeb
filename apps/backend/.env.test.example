# 应用
APP_NAME=AgentWeb API (test)
APP_ENV=test
DEBUG=false                           # 测试关 debug，减少日志噪音
DOCS_ENABLED=false                    # 测试一般不访问 docs

# 允许跨域的前端地址（测试一般只测 API，关也可以，留空列表）
CORS_ORIGINS=[]

# PostgreSQL —— 指向同一个 Postgres 实例，但数据库名加 _test
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_web_test
DATABASE_ECHO=false                   # 测试别打印每条 SQL，排错时临时改 true
DATABASE_POOL_SIZE=5                  # 测试连接池调小，省资源
DATABASE_MAX_OVERFLOW=10

# 安全（JWT 测试用固定密钥，别和生产共用）
SECURITY__JWT_SECRET_KEY=test-secret-key-please-change-this-in-production-xxxxxxxxxx
SECURITY__JWT_ALGORITHM=HS256
SECURITY__JWT_EXPIRE_MINUTES=60
SECURITY__BCRYPT_ROUNDS=4             # 测试把 bcrypt 轮数调低到 4，加速用例（生产必须 12+）

# LLM（测试一般打桩，留空让测试替身代替）
LLM__BASE_URL=
LLM__API_KEY=
LLM__MODEL=
