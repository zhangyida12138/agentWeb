.DEFAULT_GOAL := help

m ?= migration

.PHONY: help install dev format lint test coverage db-test-up db-test-down migrate revision downgrade

help:
	@echo Available targets:
	@echo   make install            Install dependencies (uv sync)
	@echo   make dev                Run the FastAPI dev server on http://localhost:8000/docs
	@echo   make format             Auto-fix and format Python code (ruff)
	@echo   make lint               Check lint rules and formatting (ruff)
	@echo   make test               Start the test database, then run pytest
	@echo   make coverage           Run pytest with a coverage report
	@echo   make db-test-up         Start the dedicated test PostgreSQL container (port 5433)
	@echo   make db-test-down       Stop the dedicated test PostgreSQL container
	@echo   make migrate            Upgrade the database to the latest revision
	@echo   make revision m="msg"   Create a new autogenerated migration
	@echo   make downgrade          Roll the database back one revision

install:
	uv sync

dev:
	uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000 --app-dir src

format:
	uv run ruff check --fix src tests migrations
	uv run ruff format src tests migrations

lint:
	uv run ruff check src tests migrations
	uv run ruff format --check src tests migrations

test: db-test-up
	uv run pytest

coverage: db-test-up
	uv run pytest --cov=app --cov-report=term-missing

# 测试库：根目录 docker-compose.yml 里的 postgres-test（5433 / agent_web_test）。
# 与开发库是两个容器、两个数据卷——测试建表/清表都不会碰到开发数据。
# --wait：等 healthcheck 通过再返回，省掉 pytest 那边因为库还在初始化而白等的几秒。
# 命令前的 `-`：Docker 未启动时不中断 make，pytest 会自己探测并给出可操作的提示。
db-test-up:
	-@docker compose -f ../../docker-compose.yml up -d --wait postgres-test

db-test-down:
	-@docker compose -f ../../docker-compose.yml stop postgres-test

migrate:
	uv run alembic upgrade head

revision:
	uv run alembic revision --autogenerate -m "$(m)"

downgrade:
	uv run alembic downgrade -1
