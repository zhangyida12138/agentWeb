# ──────────────────────────── 应用 ────────────────────────────
APP__NAME=AgentWeb API
APP__ENV=development                    # development / test / staging / production
APP__DEBUG=true
APP__DOCS_ENABLED=true
APP__PORT=8000

# 首个管理员的引导邮箱（可留空）。
# 用这个邮箱注册的账号会直接拿到 admin 角色，其余新用户一律是 reader。
# 它只在「注册」那一刻生效，已存在的账号不会被事后提权，
# 所以拿到管理员后请把它清空——留着一个能自助提权的邮箱是隐患。
APP__BOOTSTRAP_ADMIN_EMAIL=

# ──────────────────────────── 数据库 ────────────────────────────
DB__URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_web
DB__ECHO=false                         # 开发想看 SQL 就设 true
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=20
DB__POOL_PRE_PING=true

# ──────────────────────────── 安全（必填，生产请换强密钥！） ────────────────────────────
SECURITY__JWT_SECRET_KEY=please-change-this-to-a-very-long-random-string-at-least-32-chars!!!
SECURITY__JWT_ALGORITHM=HS256
SECURITY__JWT_EXPIRE_MINUTES=60
SECURITY__BCRYPT_ROUNDS=12             # 测试环境可以改 4 加速

# ──────────────────────────── CORS ────────────────────────────
CORS__ALLOW_ORIGINS=["http://localhost:5173"]
CORS__ALLOW_CREDENTIALS=true
CORS__ALLOW_METHODS=["*"]
CORS__ALLOW_HEADERS=["*"]

# ──────────────────────────── LLM（P6 Agent 用，现阶段可以留空） ────────────────────────────
LLM__BASE_URL=https://api.openai.com/v1
LLM__API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM__MODEL=gpt-4o-mini
