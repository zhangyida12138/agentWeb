
# PostgreSQL —— 测试环境（复用 docker-compose 同一个 Postgres 实例，用独立库名）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent_web          # 容器启动时创建的默认库（测试库由 pytest 自动建）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# pgAdmin（测试环境一般不用，保持默认即可）
PGADMIN_PORT=8080
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=postgres
